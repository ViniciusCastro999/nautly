BETTER_AUTH_SECRET=gere-com-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
# Opcional: sem DATABASE_URL o app usa PGlite local em ./.data
# DATABASE_URL=postgres://user:pass@host:5432/nautly
# Chave para criptografar prontuários e anexos (32 bytes em base64): openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# Opcional: integração com Google Calendar (Configurações → Integrações).
# Crie um "ID do cliente OAuth" (Aplicativo da Web) no Google Cloud com o
# redirecionamento ${BETTER_AUTH_URL}/api/integrations/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
